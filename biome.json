{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.expo",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!**/android",
			"!**/ios",
			"!**/*.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"noUnusedFunctionParameters": "warn"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noDelete": "error",
				"noBarrelFile": "off",
				"noReExportAll": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn",
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["warn", "error"] }
				}
			},
			"style": {
				"useImportType": "error",
				"useExportType": "error",
				"useConst": "error",
				"useTemplate": "warn",
				"noNonNullAssertion": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.config.{js,ts,cjs,mjs}", "**/app/**", "**/*.stories.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": { "noDefaultExport": "off" }
				}
			}
		},
		{
			"includes": ["**/*.test.{ts,tsx}", "**/__tests__/**"],
			"linter": {
				"rules": {
					"suspicious": { "noExplicitAny": "off", "noConsole": "off" }
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
